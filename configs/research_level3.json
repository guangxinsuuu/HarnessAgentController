  },
  "graph": {
    "parent_child": false,
    "sibling_failure": false,
    "shared_constraint": false,
    "equivalent_state": false,
    "tool_observation": true
  },
  "memory": {
    "enabled": false,
    "top_r": 0,
    "frozen_at_test": true
